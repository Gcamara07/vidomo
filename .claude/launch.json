{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vidomo/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vidomo/web", "exec", "next", "start", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "viewer-example",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vidomo/viewer", "example"],
      "port": 5174
    },
    {
      "name": "viewer-example-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vidomo/viewer",
        "exec",
        "vite",
        "preview",
        "--config",
        "example/vite.config.ts",
        "--outDir",
        "../dist-example"
      ],
      "port": 5174
    }
  ]
}
