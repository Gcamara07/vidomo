{
  "name": "vidomo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vidomo/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:unit": "vitest run --project web --project viewer --project scripts --project functions",
    "test:db": "vitest run --project db",
    "model:generate": "tsx scripts/generate-test-building.ts",
    "model:validate": "tsx scripts/validate-model.ts",
    "model:upload": "tsx scripts/upload-model.ts",
    "measure": "tsx scripts/measure-demo.ts",
    "model:compress": "tsx scripts/compress-model.ts",
    "demo:admin": "tsx scripts/demo-admin.ts",
    "webhook:receive": "tsx scripts/webhook-receiver.ts",
    "test:remote": "vitest run --config supabase/vitest.remote.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.10.0",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
