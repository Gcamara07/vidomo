# Copie para apps/web/.env.local (Next.js) e para .env na raiz (scripts e testes).
# Com o Supabase local, os valores aparecem em `pnpm exec supabase status`.
# Nunca commite .env / .env.local.

# URL da API do Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon / publishable) — pode ir para o navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role / secret — SÓ para scripts e testes locais. Nunca no front.
SUPABASE_SERVICE_ROLE_KEY=
